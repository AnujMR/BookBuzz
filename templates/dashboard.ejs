    <script>

        function getAnalysis() {
            console.log("getAnalysis called")
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (this.readyState == 4 && this.status == 200) {
                    var res = JSON.parse(this.response)
                    console.log(res);

                    if(res["status"] != false){
                        var pie = document.getElementsByClassName("pie_analysis");
                        var authorrating = document.getElementsByClassName("authorvsrating");
                        var genre = document.getElementsByClassName("genrewise");
                        var authorwise = document.getElementsByClassName("authorwise");
                        var topbook = document.getElementsByClassName("topbook");
                        var yearlysales = document.getElementsByClassName("yearlysales");
                        var ratingvssales = document.getElementsByClassName("ratingvssales");


                        for (var i = pie.length - 1; i >= 0; --i) {
                            pie[i].setAttribute("src", res[0]);
                        }

                        for (var i = authorrating.length - 1; i >= 0; --i) {
                            authorrating[i].setAttribute("src", res[1]);
                        }

                        for (var i = genre.length - 1; i >= 0; --i) {
                            genre[i].setAttribute("src", res[2]);
                        }

                        for (var i = authorwise.length - 1; i >= 0; --i) {
                            authorwise[i].setAttribute("src", res[3]);
                        }

                        for (var i = topbook.length - 1; i >= 0; --i) {
                            topbook[i].setAttribute("src", res[4]);
                        }

                        for (var i = yearlysales.length - 1; i >= 0; --i) {
                            yearlysales[i].setAttribute("src", res[5]);
                        }

                        for (var i = ratingvssales.length - 1; i >= 0; --i) {
                            ratingvssales[i].setAttribute("src", res[6]);
                        }

                        console.log('updated!!');
                    }

                    
                }
            };
            xhttp.open("GET", "getAnalysis", true);
            xhttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
            xhttp.send();
        }
        document.addEventListener('DOMContentLoaded', function () {
            getAnalysis()
        }, false);
    </script>
