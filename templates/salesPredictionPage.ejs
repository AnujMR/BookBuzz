<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8">
    <title> BookBuzz </title>
    <link rel="stylesheet" href="/static/style.css">
    <!-- Boxicons CDN Link -->
    <link href='https://unpkg.com/boxicons@2.0.7/css/boxicons.min.css' rel='stylesheet'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

    <script src="https://kit.fontawesome.com/7f212a760d.js" crossorigin="anonymous"></script>


</head>

<body>
    <div class="sidebar">
        <div class="logo-details">
            <i class="fa-solid fa-b icon"></i>
            <div class="logo_name">BookBuzz</div>
            <i class='bx bx-menu' id="btn"></i>
        </div>
        <ul class="nav-list">
            <!-- <li>
                        <i class='bx bx-search'></i>
                        <input type="text" placeholder="Search...">
                        <span class="tooltip">Search</span>
                    </li> -->
            <li>
                <a href="/dashboard">
                    <i class="fa-solid fa-chart-simple"></i>
                    <span class="links_name">Dashboard</span>
                </a>
                <span class="tooltip">Dashboard</span>
            </li>
            <li>
                <a href="/autogeneration">
                    <i class="fa-solid fa-pen-clip fa-sm"></i>
                    <span class="links_name">Generate Post</span>
                </a>
                <span class="tooltip">Generate Post</span>
            </li>
            <li>
                <a href="/qualityEvaluation">
                    <i class="fa-solid fa-spell-check"></i>
                    <span class="links_name">Quality Evaluation</span>
                </a>
                <span class="tooltip">Quality Evaluation</span>
            </li>
            <li>
                <a href="/salesPrediction">
                    <i class="fa-solid fa-robot"></i>
                    <span class="links_name">Sales Prediction</span>
                </a>
                <span class="tooltip">Sales Prediction</span>
            </li>
            <li>
                <a href="/bookInventory">
                    <i class="fa-solid fa-book"></i>
                    <span class="links_name">Bookshelf</span>
                </a>
                <span class="tooltip">Bookshelf</span>
            </li>

            <li class="profile">
                <div class="profile-details">
                    <div class="name_job">
                        <div class="name">{{user["username"]}}</div>
                        <div class="job">Developers</div>
                    </div>
                </div>
                <i class='bx bx-log-out' id="log_out"></i>
            </li>
        </ul>
    </div>
    <section class="home-section">
        <img src="/static/banner-bg.jpg"
            style="height: 100%; width: 50%; position: absolute; right: 0; top: 0; z-index: -1;" alt="" srcset="">
        <div class="text">SALES PREDICTION</div>
        <br>
        <br>
        <div class="row" style="margin-left: 2rem;">
            <div class="col-md-5">
                <form action="/salesPrediction" method="post" name="f1">
                    <div class="row">
                        <div class="col-md-5">
                            <div>
                                <p class="text-field-title">Book Name</p>
                                <input type="text" name="name" id="nameField" class="text-field left-margin">
                            </div>
                            <datalist id="genres">
                                {% set genreList= genres %}
                                {% for i in range(0, genreList|length)%}
                                <option>
                                    {{genreList[i]}}
                                </option>
                                {% endfor %}
                            </datalist>
                            <datalist id="publishers">
                                {% set publisherList = publishers %}
                                {% for i in range(0, publisherList|length)%}
                                <option>
                                    {{publisherList[i]}}
                                </option>
                                {% endfor %}
                            </datalist>
                            <datalist id="languages">
                                {% set languageList = languages %}
                                {% for i in range(0, languageList|length)%}
                                <option>
                                    {{languageList[i]}}
                                </option>
                                {% endfor %}
                            </datalist>
                            <datalist id="authors">
                                {% set authorList = authors %}
                                {% for i in range(0, authorList|length)%}
                                <option>
                                    {{authorList[i]}}
                                </option>
                                {% endfor %}
                            </datalist>
                            <div style="margin-top: 40px;">
                                <p class="text-field-title">Genre</p>
                                <input autoComplete="on" list="genres" type="text" name="genre" id="genreField"
                                    class="text-field left-margin">
                            </div>
                            <div style="margin-top: 40px;">
                                <p class="text-field-title">Author</p>
                                <input autoComplete="on" list="authors" type="text" name="author" id="authorField"
                                    class="text-field left-margin">
                            </div>
                        </div>
                        <div class="col-md-5" style="margin-left: 40px;">
                            <div>
                                <p class="text-field-title">Publisher</p>
                                <input autoComplete="on" list="publishers" type="text" name="publisher"
                                    id="publisherField" class="text-field left-margin">
                            </div>
                            <div style="margin-top: 40px;">
                                <p class="text-field-title">Language</p>
                                <input autoComplete="on" list="languages" type="text" name="language" id="languageField"
                                    class="text-field left-margin">
                            </div>
                            <div style="margin-top: 40px;">
                                <p class="text-field-title">Price</p>
                                <input type="number" name="price" id="priceField" class="text-field left-margin">
                            </div>
                        </div>
                    </div>


                    <!-- <div style="margin-top: 40px;">
                        <p class="text-field-title">Author Name</p>
                        <input type="text" name="author" id="authorField" class="text-field left-margin">
                    </div> -->

                    <div style="margin-top: 60px;">
                        <p class="text-field-title" style="display: inline; margin-right: 30px;">Rating</p>
                        <p id="rangeText" style="font-size: 16px; font-weight: 500; color: white; display: inline;"></p>
                        <div class="slidecontainer" style="margin-top: 20px;">
                            <input style="width: 240px;" name="rating" type="range" min="0" max="100" value="0.1"
                                class="slider" id="myRange">
                        </div>
                        <!-- <input type="number" name="rating" id="ratingField" class="text-field left-margin"> -->
                    </div>
                    <button type="button" onclick="predict()" class="generate-btn left-margin"
                        style="margin-top: 50px; margin-left: 8rem;" id="generateBtn">Predict</button>

                </form>
            </div>
            <div id="main-prediction" class="col-md-7 d-flex justify-content-center text-center"
                style="margin-top: 20px;">
                <div id="prediction-div" class="prediction-div">
                    <div>
                        <p style="font-size: 40px; font-weight: 500; padding: 10px; color: white;">
                            Predicted Sales
                        </p>
                        <br>
                        <br>
                    </div>
                    <div style=" margin-top: 40px;">
                        <p id="sales"
                            style="font-size: 60px; font-weight: 600; color: rgb(0, 255, 26); display: inline;"> -- </p>
                        <p style="font-size: 35px; font-weight: 600; color: white;">Yearly Sales</p>
                        <!-- <br>
                                        <br>
                                        <p id="percent" style="font-size: 30px; color: rgb(0, 255, 0); display: inline;">83.7% </p>
                                        <p id="percentTxt"
                                            style="font-size: 22px; font-weight: 600; color: white; color: rgb(0, 255, 0); display: inline;">
                                            more than average sales in Comedy genre</p> -->
                    </div>
                </div>
                <div id="loader" class="loader" style="display: none; margin-top: 170px;"></div>

            </div>
        </div>
    </section>
    <script>
        let sidebar = document.querySelector(".sidebar");
        let closeBtn = document.querySelector("#btn");
        let logoutBtn = document.querySelector("#log_out");

        logoutBtn.addEventListener("click", () => {
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (this.readyState == 4 && this.status == 200) {

                    // document.getElementById("loader").style.display = "none";

                    var res = JSON.parse(this.response);
                    console.log(res)

                    if (res['status']) {
                        window.location.assign("/")
                    } else {
                    }

                    // document.getElementById("cohesion").innerHTML = res[0][0].toFixed(2);

                    console.log(this.responseText)

                }
            };
            xhttp.open("POST", "logout", true);
            xhttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
            let body = ``;
            xhttp.send(body);
        })

        closeBtn.addEventListener("click", () => {
            sidebar.classList.toggle("open");
            menuBtnChange();//calling the function(optional)
        });


        // following are the code to change sidebar button(optional)
        function menuBtnChange() {
            if (sidebar.classList.contains("open")) {
                closeBtn.classList.replace("bx-menu", "bx-menu-alt-right");//replacing the iocns class
            } else {
                closeBtn.classList.replace("bx-menu-alt-right", "bx-menu");//replacing the iocns class
            }
        }

        var slider = document.getElementById("myRange");
        var output = document.getElementById("rangeText");
        output.innerHTML = slider.value; // Display the default slider value

        // Update the current slider value (each time you drag the slider handle)
        slider.oninput = function () {
            output.innerHTML = (this.value / 10).toFixed(1);
        }

        function predict() {

            let name = document.f1.name.value;
            let genre = document.f1.genre.value;
            let publisher = document.f1.publisher.value;
            let author = document.f1.author.value;
            let language = document.f1.language.value;
            let price = document.f1.price.value;
            let rating = slider.value;

            if (name === "" || genre === "" || publisher === "" || author === "" || language === "") {
                return;
            }

            console.log(document.f1.rating.value)

            var x = document.getElementById('prediction-div').style.display = 'none';



            // var x = document.getElementsByClassName('score_div');
            // var i;
            // for (i = 0; i < x.length; i++) {
            //     x[i].style.display = 'none';
            // }

            document.getElementById("loader").style.display = "inline-block";

            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (this.readyState == 4 && this.status == 200) {

                    document.getElementById("loader").style.display = "none";
                    var res = JSON.parse(this.response);
                    console.log(res);
                    // document.getElementById("cohesion").innerHTML = res[0][0].toFixed(2);
                    // var avg = res[1].toFixed(2)
                    var x = document.getElementById('prediction-div').style.display = 'inline';
                    var x = document.getElementById('sales').innerHTML = '&dollar;' + res[0].toFixed(0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                }
            };
            xhttp.open("POST", "salesPrediction", true);
            xhttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
            let body = `name=${name}&genre=${genre}&rating=${rating}&price=${price}&author=${author}&publisher=${publisher}&language=${language}`
            xhttp.send(body);
        }
    </script>
</body>

</html>